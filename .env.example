# ─────────────────────────────────────────────────────────────────
# isola
# Copy to .env and edit as needed; all values shown are the defaults
# so `docker compose up --build` works without any .env file present.
# ─────────────────────────────────────────────────────────────────

# Docker project name
COMPOSE_PROJECT_NAME=isola

# Host port the UI + API are exposed on
ISOLA_PORT=8080

# CORS — set to the public origin(s) if you reverse-proxy through a different host.
# Several origins may be given, separated by commas or spaces.
CORS_ORIGIN=http://localhost:8080

# Default session parameters
RESOLUTION=1280x720
SESSION_DEFAULT_MIN=10
SESSION_MAX_MIN=30
SESSION_EXTEND_MIN=5
SESSION_TIMER=true
INACTIVITY_MIN=5

# Session container image. Unset = the image the Compose stack builds
# (isola-browser:electron). Set a published/prebuilt image to run without a
# local build of the browser sandbox.
# ISOLA_BROWSER_IMAGE=isola-browser:electron

# When true, skip URL safety checks on session create. Keep false on shared hosts.
DISABLE_URL_VALIDATION=false

# Optional default for Tor session exit-node pinning: ISO 3166-1 alpha-2 codes,
# comma-separated for several (e.g. se or se,no). Applies to sessions created
# with tor_enabled; a session may override it per request. Empty = any exit.
# ISOLA_TOR_EXIT_COUNTRY=

# Log Level
LOG_LEVEL=info

# Optional: require Bearer token on POST /api/sessions (internet-facing deploys).
# Comma-separate several tokens. Store one of them in localStorage.isola_api_token for the UI.
# ISOLA_API_TOKEN=   # openssl rand -hex 32   or  token-one,token-two

# MCP (Model Context Protocol) — Streamable HTTP at POST /mcp for AI agents.
# Any MCP client: point it at http://localhost:8080/mcp with a Bearer token.
# Verify: go test ./backend/pkg/mcp/
# ISOLA_MCP_ENABLED=true
# ISOLA_MCP_TOKEN=   # openssl rand -hex 32   or  token-one,token-two

# Out-of-process modules directory (optional). When set, loads plugin modules from this dir.
# ISOLA_MODULES_DIR=

# Network capture window: how many requests a session keeps for the network
# panel and MCP get_network. Unset = 1000; values above 10000 are capped.
ISOLA_NETWORK_LOG_MAX_ENTRIES=1000
